{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CD Nearby",
  "version": "0.1.0",
  "identifier": "in.yash0.cd.nearby",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nearby — by CD",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 620,
        "backgroundColor": "#f6f5f1",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": { "active": false }
}
