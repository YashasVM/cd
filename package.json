{
  "name": "cd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-install.mjs && vite --host 127.0.0.1",
    "build": "npm run skill:check && node scripts/build-design.mjs && node scripts/sync-install.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "audit": "npm audit --audit-level=moderate",
    "test": "npm run skill:check && node --test src/*.test.js scripts/bench-metrics.test.mjs",
    "test:cli": "go test ./...",
    "typecheck": "tsc",
    "verify:agent": "npm run build && node scripts/verify-agent.mjs",
    "verify:terminal": "npm run build && node scripts/verify-terminal.mjs",
    "verify:cli-loop": "node scripts/verify-cli-loop.mjs",
    "bench": "npm run build && node scripts/bench.mjs",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "verify:browser": "npm run build && node scripts/verify-browser.mjs",
    "skill:generate": "node scripts/generate-sharing-skill.mjs",
    "skill:check": "node scripts/generate-sharing-skill.mjs --check",
    "verify:retries": "npm run build && node scripts/verify-retries.mjs",
    "verify:transports": "npm run build && node scripts/verify-transports.mjs"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "peerjs": "1.5.5",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "^4.145.0"
  }
}
